# Copia este archivo a .env.local y completa los valores reales.
# .env.local nunca se sube a git.

# Supabase: Project Settings > API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Mismo proyecto — el cliente por-request (login, RLS) necesita las variables
# NEXT_PUBLIC_* porque también corren en el browser. La URL es la misma de
# arriba; la anon key está en el mismo Project Settings > API, campo "anon public".
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Anthropic: console.anthropic.com > API Keys
ANTHROPIC_API_KEY=sk-ant-...
